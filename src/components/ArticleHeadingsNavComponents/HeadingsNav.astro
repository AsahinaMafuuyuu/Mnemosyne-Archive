---
import CaterIcon from "@/assets/Icons/cater.svg";
import MagicBookIcon from "@/assets/Icons/magic-book.svg";
import ContentsIcon from "@/assets/Icons/contents.svg";
import AsideInfo from "../AsideComponents/AsideInfo.astro";
type headingsNoChild = {
    level: number;
    id: string;
    title: string;
};
const { contents } = Astro.props as {
    contents: Array<headingsNoChild>;
};
---

<!-- 导航栏 -->
<div
    class="layout-basic-style sticky top-0 py-4 h-[70vh] flex flex-col items-start gap-2"
>
    <!-- 按钮添加 -->

    <div
        class="w-full sticky top-0 px-2 flex justify-between items-center rounded-xl bg-amber-50"
    >
        <!-- 个人信息展示 -->
        <button
            data-selected="false"
            data-ui="show-aside-personal"
            class="link-container selected:bg-amber-200 transition-all ease-in-out duration-500 p-2"
        >
            <CaterIcon class="lg-icon-basic-style" />
            <span class="hidden selected:display-block">文章目录</span>
        </button>
        <!-- 目录 -->
        <button
            data-selected="true"
            data-ui="show-aside-personal"
            class="link-container selected:bg-amber-200 transition-all ease-in-out duration-500 p-2"
        >
            <ContentsIcon class="lg-icon-basic-style" />
            <span class="hidden selected:block">文章目录</span>
        </button>
        <!-- 相关文章推荐 -->
        <button
            data-selected="false"
            data-ui="show-aside-personal"
            class="link-container selected:bg-amber-200 transition-all ease-in-out duration-500 p-2"
        >
            <MagicBookIcon class="lg-icon-basic-style" />
        </button>
    </div>

    <!-- 然后就是展示区域 -->
    <div class="w-full overflow-auto">
        <!-- <AsideInfo /> -->
        <div
            data-ui="contents-nav"
            class="w-full overflow-auto p-3 flex flex-col"
        >
            {
                contents.map((item) => {
                    return (
                        <a
                            data-ui="article-nav-item"
                            id={`nav-${item.id}`}
                            data-selected="false"
                            href={"#" + item.id}
                            class:list={[
                                "basic-article-nav",
                                item.level === 2 && "h2-nav",
                                item.level === 3 && "h3-nav",
                                item.level === 4 && "h4-nav",
                            ]}
                        >
                            {item.title}
                        </a>
                    );
                })
            }
        </div>
    </div>
</div>

<!-- 存储对应的导航项 -->
<script>
    function init() {
        let navItemId: string | null = null;
        const elms = document.querySelectorAll("[data-ui='article-nav-item']");
        elms.forEach((dom) => {
            dom.addEventListener("click", () => {
                cleanOtherItem();
                console.log('dom.id: ', dom)
                navItemId = dom.id;
                setItemSelected();
            });
        });
        const cleanOtherItem = () => {
            if (navItemId) {
                const item = document.getElementById(navItemId!);
                item!.dataset!.selected = "false";
            }
        };

        const setItemSelected = () => {
            if (navItemId) {
                const item = document.getElementById(navItemId!);
                console.log(item)
                item!.dataset!.selected = "true";
                console.log(navItemId);
            }
        };
    }
    document.addEventListener('astro:page-load', init)
    
</script>
