---
import CaterIcon from "@/assets/Icons/cater.svg";
import MagicBookIcon from "@/assets/Icons/magic-book.svg";
import ContentsIcon from "@/assets/Icons/contents.svg";
import AsideInfo from "../AsideComponents/AsideInfo.astro";
type headingsNoChild = {
    level: number;
    id: string;
};
const { contents } = Astro.props as {
    contents: Array<headingsNoChild>;
};
---

<!-- 导航栏 -->
<div
    class="layout-basic-style sticky top-0 py-4 overflow-auto flex flex-col items-start gap-2"
>
    <!-- 按钮添加 -->

    <div
        class="w-full px-2 flex justify-between items-center rounded-xl bg-amber-50"
    >
        <!-- 个人信息展示 -->
        <button
            data-selected="false"
            data-ui="show-aside-personal"
            class="link-container selected:bg-amber-200 transition-all ease-in-out duration-500 p-2"
        >
            <CaterIcon class="md-icon-basic-style" />
            <span class="hidden selected:display-block">文章目录</span>
        </button>
        <!-- 目录 -->
        <button
            data-selected="true"
            data-ui="show-aside-personal"
            class="link-container selected:bg-amber-200 transition-all ease-in-out duration-500 p-2"
        >
            <ContentsIcon class="md-icon-basic-style" />
            <span class="hidden selected:block">文章目录</span>
        </button>
        <!-- 相关文章推荐 -->
        <button
            data-selected="false"
            data-ui="show-aside-personal"
            class="link-container selected:bg-amber-200 transition-all ease-in-out duration-500 p-2"
        >
            <MagicBookIcon class="md-icon-basic-style" />
        </button>
    </div>

    <!-- 然后就是展示区域 -->
    <div class="">
        <!-- <AsideInfo /> -->
        <div data-ui="contents-nav" class="w-full overflow-auto p-2">
            {
                contents.map((item) => {
                    return (
                        <a
                            href={"#" + item.id}
                            class={"h" + item.level + "-nav basic-article-nav"}
                        >
                            {item.id}
                        </a>
                    );
                })
            }
        </div>
    </div>
</div>
