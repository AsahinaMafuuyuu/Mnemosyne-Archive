---
import CaterIcon from "@/assets/Icons/cater.svg";
import MagicBookIcon from "@/assets/Icons/magic-book.svg";
import ContentsIcon from "@/assets/Icons/contents.svg";
import AsideInfo from "../AsideComponents/AsideInfo.astro";

type headingsNoChild = {
    level: number;
    id: string;
    title: string;
};
const { contents } = Astro.props as {
    contents: Array<headingsNoChild>;
};
---

<!-- 导航栏 -->
<div
    id="HeadingsNav"
    class="layout-basic-style sticky top-0 pb-4 h-[70vh] dark:bg-neutral-900 flex flex-col items-start"
>
    <!-- 按钮添加 -->

    <div
        class="w-full px-2 flex justify-between items-center rounded-md
         bg-amber-50 dark:bg-[rgb(21,27,35)] text-body border border-(--border-color)"
    >
        <!-- 个人信息展示 -->
        <button
            data-selected="false"
            data-ui="show-aside-personal"
            class="link-container selected:bg-amber-200 dark:selected:bg-[rgba(100,150,255,0.25)] transition-all ease-in-out duration-500 p-2"
        >
            <CaterIcon class="lg-icon-basic-style" />
            <span class="hidden selected:inline-block">个人信息</span>
        </button>
        <!-- 目录 -->
        <button
            data-selected="true"
            data-ui="show-aside-nav"
            class="link-container selected:bg-amber-200 dark:selected:bg-[rgba(100,150,255,0.25)] transition-all ease-in-out duration-500 p-2"
        >
            <ContentsIcon class="lg-icon-basic-style" />
            <span class="hidden selected:inline-block">文章目录</span>
        </button>
        <!-- 相关文章推荐 -->
        <button
            data-selected="false"
            data-ui="show-aside-recommend"
            class="link-container selected:bg-amber-200 dark:selected:bg-[rgba(100,150,255,0.25)] transition-all ease-in-out duration-500 p-2"
        >
            <MagicBookIcon class="lg-icon-basic-style" />
            <span class="hidden selected:inline-block">更多推荐</span>
        </button>
    </div>

    <!-- 然后就是展示区域 -->
    <div data-ui="aside-nav" class="w-full overflow-auto base-scroll-bar">
        <!-- <AsideInfo /> -->
        <div
            data-ui="contents-nav"
            class="w-full overflow-auto py-3 px-1 flex flex-col"
        >
            {
                contents.map((item) => {
                    return (
                        <a
                            data-ui="article-nav-item"
                            id={`nav-${item.id}`}
                            data-selected="false"
                            href={"#" + item.id}
                            class:list={[
                                "basic-article-nav",
                                item.level === 2 && "h2-nav",
                                item.level === 3 && "h3-nav",
                                item.level === 4 && "h4-nav",
                            ]}
                        >
                            {item.title}
                        </a>
                    );
                })
            }
        </div>
    </div>

    <!-- 个人信息展示区域 -->
    <div data-ui="aside-personal" class="hidden base-scroll-bar">
        <AsideInfo />
    </div>

    <!-- 更多文章展示区域 -->
    <div data-ui="aside-recommend" class="hidden overflow-auto base-scroll-bar"></div>
</div>

<!-- 存储对应的导航项 -->
<script>
    function init() {
        let navItemId: string | null = null;
        const elms = document.querySelectorAll("[data-ui='article-nav-item']");
        elms.forEach((dom) => {
            dom.addEventListener("click", () => {
                cleanOtherItem();
                navItemId = dom.id;
                setItemSelected();
            });
        });
        const cleanOtherItem = () => {
            if (navItemId) {
                const item = document.getElementById(navItemId!);
                item!.dataset!.selected = "false";
            }
        };

        const setItemSelected = () => {
            if (navItemId) {
                const item = document.getElementById(navItemId!);
                item!.dataset!.selected = "true";
            }
        };

        // 绑定元素
        const headingNav = document.getElementById("HeadingsNav");

        // 绑定个人信息按钮
        const asidePersonalBtn: HTMLButtonElement = headingNav?.querySelector(
            '[data-ui="show-aside-personal"]',
        ) as HTMLButtonElement;

        // 绑定个人信息
        const asidePersonal: HTMLElement = headingNav?.querySelector(
            '[data-ui="aside-personal"]',
        ) as HTMLElement;

        // 绑定目录按钮
        const asideNavBtn: HTMLButtonElement = headingNav?.querySelector(
            '[data-ui="show-aside-nav"]',
        ) as HTMLButtonElement;

        // 绑定目录
        const asideNav: HTMLElement = headingNav?.querySelector(
            '[data-ui="aside-nav"]',
        ) as HTMLElement;

        // 绑定更多推荐按钮
        const asideRecommendBtn: HTMLButtonElement = headingNav?.querySelector(
            '[data-ui="show-aside-recommend"]',
        ) as HTMLButtonElement;

        // 绑定更多推荐
        const asideRecommend: HTMLElement = headingNav?.querySelector(
            '[data-ui="aside-recommend"]',
        ) as HTMLElement;

        asidePersonalBtn.addEventListener("click", () => {
            asideNavBtn.dataset.selected = "false";
            asideRecommendBtn.dataset.selected = "false";
            asidePersonalBtn.dataset.selected = "true";
            asidePersonal.style.setProperty("display", "block");
            asideNav.style.setProperty("display", "none");
            asideRecommend.style.setProperty("display", "none");
            // 关闭掉另外两个
        });

        asideNavBtn.addEventListener("click", () => {
            asidePersonalBtn.dataset.selected = "false";
            asideRecommendBtn.dataset.selected = "false";
            asideNavBtn.dataset.selected = "true";
            asideNav.style.setProperty("display", "block");
            asidePersonal.style.setProperty("display", "none");
            asideRecommend.style.setProperty("display", "none");
            // 关闭掉另外两个
        });

        asideRecommendBtn.addEventListener("click", () => {
            asidePersonalBtn.dataset.selected = "false";
            asideNavBtn.dataset.selected = "false";
            asideRecommendBtn.dataset.selected = "true";
            asideRecommend.style.setProperty("display", "block");
            asideNav.style.setProperty("display", "none");
            asidePersonal.style.setProperty("display", "none");
            // 关闭掉另外两个
        });
    }
    document.addEventListener("astro:page-load", init);
</script>
