---
import SettingIcon from "@/assets/Icons/themeSetting.svg";
import System from "@/assets/Icons/mode-system.svg";
import Light from "@/assets/Icons/mode-light.svg";
import Dark from "@/assets/Icons/mode-dark.svg";
import Rss from "@/assets/Icons/rss.svg";
---

<div class="relative">
    <div data-ui="setting-btn" class="text-header simp-control-interact">
        <!-- 后面需要动态展示功能列表以及搜索框 -->

        <SettingIcon class="w-6 h-6" />
    </div>
    <!-- 动态的打开设置栏 -->
    <div
        data-hidden="true"
        data-ui="web-theme-control-panel"
        class="text-theme-setting hidden:invisible w-fit h-fit opacity-100 transition-all ease-in-out duration-1000 hidden:opacity-0 absolute top-[calc(100%+15px)] -right-3 p-3 layout-basic-style"
    >
        <div class="w-full flex flex-col gap-3">
            <!-- 主题设置 背景图片切换 模糊设置 保存当前背景图片 订阅RSS -->
            <div class="flex justify-center items-center gap-3">
                <span class="truncate">主题设置</span>
                <div class="flex gap-2">
                    <button
                        data-ui="switch-light-theme"
                        class="link-container p-2"
                    >
                        <Light
                            class="w-5 h-5 flex items-center justify-center"
                        />
                    </button>
                    <button
                        data-ui="switch-dark-theme"
                        class="link-container p-2"
                    >
                        <Dark
                            class="w-5 h-5 flex items-center justify-center"
                        />
                    </button>
                    <button
                        data-ui="switch-matchMedia-theme"
                        class="link-container p-2"
                    >
                        <System
                            class="w-5 h-5 flex items-center justify-center"
                        />
                    </button>
                </div>
            </div>

            <button
                data-forbidden="false"
                id="switchBackground"
                class="w-full link-container py-2"
            >
                <span class="truncate">背景图片切换</span>
            </button>

            <button
                data-forbidden="false"
                data-ui="downloadBg"
                class="w-full link-container py-2"
            >
                <span class="truncate">下载背景图</span>
            </button>

            <div class="flex items-center justify-between">
                禁用背景图
                <button
                    data-activated="true"
                    data-ui="disabled-btn"
                    class="dynamic-btn"></button>
            </div>

            <div
                data-ui="scroll-bar-setting"
                class="flex flex-col items-center justify-between gap-3"
            >
                <div class="w-full flex justify-between">
                    <span class="truncate">模糊设置</span>
                    <span data-ui="blur-value" class="truncate">0px</span>
                </div>
                <input
                    type="range"
                    min="0"
                    max="15"
                    value="0"
                    class="w-full blur-setting-scroll-bar"
                />
            </div>

            <div class="flex justify-between items-center">
                <span class="truncate">订阅RSS</span>
                <button data-ui="rss-btn" class="link-container p-2">
                    <Rss class="w-5 h-5 flex items-center justify-center" />
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    [data-ui="rss-btn"][data-copied="true"] {
        position: relative;
    }
    [data-ui="rss-btn"][data-copied="true"]::after {
        content: "已复制!";
        position: absolute;
        right: calc(100% + 6px);
        top: 50%;
        transform: translateY(-50%);
        font-size: 0.75rem;
        white-space: nowrap;
        padding: 2px 6px;
        border-radius: 4px;
        background-color: var(--color-accent, #4f46e5);
        color: white;
        pointer-events: none;
    }
</style>

<script>
    // 导入背景图片url和是否禁用背景图片
    import {
        bgState,
        setBgUrl,
        setDisabledBackground,
        setBgBlur,
        fetchBackgroundImage,
        revokeBackgroundImage
    } from "@/stores/theme";
    function init() {
        const SettingBtn: HTMLElement = document.querySelector(
            '[data-ui="setting-btn"]',
        ) as HTMLElement;

        const controlPanel: HTMLElement = document.querySelector(
            '[data-ui="web-theme-control-panel"]',
        ) as HTMLElement;

        // 获取切换日光模式按钮
        const switchLightThemeBtn: HTMLElement = controlPanel.querySelector(
            '[data-ui="switch-light-theme"]',
        ) as HTMLElement;

        // 获取切换黑夜模式按钮
        const switchDarkThemeBtn: HTMLElement = controlPanel.querySelector(
            '[data-ui="switch-dark-theme"]',
        ) as HTMLElement;

        // 获取切换跟随系统按钮
        const switchMatchMediaThemeBtn: HTMLElement = controlPanel.querySelector(
            '[data-ui="switch-matchMedia-theme"]',
        ) as HTMLElement;

        // 获取到scrollbar容器
        const scrollBarDiv: HTMLElement = controlPanel.querySelector(
            '[data-ui="scroll-bar-setting"]',
        ) as HTMLElement;

        // 获取模糊字体
        const blurValue: HTMLElement = controlPanel.querySelector(
            '[data-ui="blur-value"]',
        ) as HTMLElement;

        // 获取到背景主题切换按钮
        const switchBackgroundBtn: HTMLElement = document.getElementById(
            "switchBackground",
        ) as HTMLElement;

        // 获取scrollbar
        const scrollBar: HTMLInputElement = scrollBarDiv.querySelector(
            ".blur-setting-scroll-bar",
        ) as HTMLInputElement;

        // 获取到下载背景图按钮
        const downloadBgBtn: HTMLElement = controlPanel.querySelector(
            '[data-ui="downloadBg"]',
        ) as HTMLElement;

        // 获取到禁用背景按钮
        const disabledBgBtn: HTMLElement = controlPanel.querySelector(
            '[data-ui="disabled-btn"]',
        ) as HTMLElement;

        // 获取到订阅RSS按钮
        const subscribeRssBtn: HTMLElement = controlPanel.querySelector(
            '[data-ui="rss-btn"]'
        ) as HTMLElement
        
        // 设置按钮点击事件，切换控制面板显示状态
        SettingBtn.addEventListener("click", () => {
            if (controlPanel.dataset.hidden === "false") {
                controlPanel.dataset.hidden = "true";
            } else {
                controlPanel.dataset.hidden = "false";
            }
        });

        // 点击控制面板以外的区域，关闭控制面板
        document.addEventListener("click", (e) => {
            if (
                !controlPanel.contains(e.target as Node) &&
                !SettingBtn.contains(e.target as Node)
            ) {
                controlPanel.dataset.hidden = "true";
            }
        });

        // 切换主题色
        switchDarkThemeBtn.addEventListener("click", () => {
            window.document.documentElement.dataset.theme = "dark";
            localStorage.setItem("theme", "dark");
        });

        switchLightThemeBtn.addEventListener("click", () => {
            window.document.documentElement.dataset.theme = "light";
            localStorage.setItem("theme", "light");
        });

        switchMatchMediaThemeBtn.addEventListener('click', () => {
            const theme = window.matchMedia('(prefers-color-scheme: light)').matches;
            window.document.documentElement.dataset.theme = theme? 'light' : 'dark';
            localStorage.setItem("theme", "match-media");
        })

        // 下载背景图
        downloadBgBtn.addEventListener("click", async () => {
            const url = getComputedStyle(document.documentElement)
                .getPropertyValue("--background-src")
                .slice(4, -1)
                .replace(/"/g, "");
            const link = document.createElement("a");
            link.href = url;
            link.download = new Date().getTime().toString(); // 设置下载的文件名，可以根据需要修改
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        });

        // 通过bgState.disabledBtnIsActived来修改btn的样式
        function initDisabledBtnStyle() {
            if (bgState.disabledBtnIsActived) {
                disabledBgBtn.dataset.activated = "true";
                switchBackgroundBtn.dataset.forbidden = "true";
                downloadBgBtn.dataset.forbidden = "true";
            } else {
                disabledBgBtn.dataset.activated = "false";
                switchBackgroundBtn.dataset.forbidden = "false";
                downloadBgBtn.dataset.forbidden = "false";
            }
        }

        // 切换背景
        // 需要同时切换掉bgUrl
        switchBackgroundBtn.addEventListener("click", async () => {
            // --background-src: url(../assets/bg-2.jpg);
            // 返回的content-type是image/jpeg或者image/png
            const url = await fetchBackgroundImage();
            document.documentElement.style.setProperty(
                "--background-src",
                `url(${url})`,
            );
            // 销毁掉原来的bgUrl对象
            revokeBackgroundImage()
        });

        // 定义函数
        // 该函数主要是用来对禁用背景图按钮事件发生的回调函数
        async function settingBg() {
            if (!bgState.disabledBtnIsActived) {
                // 开始禁用
                setBgUrl(
                    document.documentElement.style
                        .getPropertyValue("--background-src")
                        .slice(4, -1),
                );

                document.documentElement.style.setProperty(
                    "--background-src",
                    "none",
                );
                disabledBgBtn.dataset.activated = "true";
                switchBackgroundBtn.dataset.forbidden = "true";
                downloadBgBtn.dataset.forbidden = "true";
                setDisabledBackground(true);
            } else {
                // 如果用户一开始进入网站就是禁用图片的话，则默认不获取url
                // 需要重新fetch
                if (!bgState.bgUrl) {
                    const bgurl = await fetchBackgroundImage();
                    document.documentElement.style.setProperty(
                        "--background-src",
                        `url(${bgurl})`,
                    );
                    setBgUrl(bgurl);
                } else {
                    document.documentElement.style.setProperty(
                        "--background-src",
                        `url(${bgState.bgUrl})`,
                    );
                }
                disabledBgBtn.dataset.activated = "false";
                switchBackgroundBtn.dataset.forbidden = "false";
                downloadBgBtn.dataset.forbidden = "false";
                setDisabledBackground(false);
            }
        }
        // 禁用背景
        disabledBgBtn.addEventListener("click", settingBg);

        // 订阅RSS：复制RSS链接到剪贴板
        const rssFeedBtn: HTMLElement = controlPanel.querySelector(
            '[data-ui="rss-btn"]',
        ) as HTMLElement;

        rssFeedBtn.addEventListener("click", async () => {
            const rssUrl = new URL("/rss.xml", window.location.origin).href;
            try {
                await navigator.clipboard.writeText(rssUrl);
                rssFeedBtn.dataset.copied = "true";
                setTimeout(() => {
                    rssFeedBtn.removeAttribute("data-copied");
                }, 2000);
            } catch {
                window.open(rssUrl, "_blank");
            }
        });

        // 添加模糊滚动条滚动设计
        scrollBar.addEventListener("input", () => {
            scrollBar.style.setProperty("--val", scrollBar.value);
            blurValue.innerHTML = `${scrollBar.value}px`;
            document.documentElement.style.setProperty(
                "--blur-val",
                `${scrollBar.value}px`,
            );

            // 设置模糊度
            setBgBlur(Number(scrollBar.value));
        });

        // 订阅RSS
        subscribeRssBtn.addEventListener('click', async () => {
            const rssUrl = new URL('/rss.xml', window.location.origin).href
             try {
                await navigator.clipboard.writeText(rssUrl);
                subscribeRssBtn.dataset.copied = "true";
                setTimeout(() => {
                    subscribeRssBtn.removeAttribute("data-copied");
                }, 2000);
            } catch {
                window.open(rssUrl, "_blank");
            }
        })

        // 初始化的时候需要先读取是否禁用背景
        // 通过禁用背景来判断button的样式
        initDisabledBtnStyle();
    }

    // 每次after-swap以后重新挂载内容
    document.addEventListener("astro:after-swap", () => {
        // 初始化
        init();
    });

    // 重新挂载也要init
    document.addEventListener("DOMContentLoaded", () => {
        // 初始化
        init();
    });
</script>
