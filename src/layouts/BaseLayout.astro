---
import Header from "@/components/HeaderComponents/Header.astro";
import AsideInfo from "@/components/AsideComponents/AsideInfo.astro";
import Footer from "@/components/FooterComponents/Footer.astro";
import { ClientRouter, fade } from "astro:transitions";
import ToTopIcon from "@/assets/Icons/to-top.svg";
import "../styles/global.css";
import AudioPlayerAside from "@/components/AudioPlayerComponents/AudioPlayerAside.astro"
import NormalCursor from "@/components/DynamicCursor/Normal/index.astro";
import ReactAudioPlayerAside from '@/components/AudioPlayerComponents/AudioPlayerAside'
const url: string = Astro.url.toString();
const params = Astro.props?.params;
---

<html lang="zh-CN" class="base-scroll-bar scroll-smooth">
  <head>
    <!-- 引入google analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-E4E7YKZK0H"
    ></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-XXXX");
    </script>

    <!-- 引入umami -->
    <script
      defer
      src="https://cloud.umami.is/script.js"
      data-website-id="87c95ac3-3d77-4b6b-9f73-1cc473f30bb5"></script>

    <!-- 下面就是正常构建 -->
    <meta charset="utf-8" />
    <link rel="icon" href="/Icons/favicon.ico" sizes="any" />
    <link rel="icon" type="image/x-icon" href="/Icons/favicon.ico" />
    <link
      rel="icon"
      type="image/x-icon"
      sizes="32x32"
      href="/Icons/favicon-32x32.ico"
    />
    <link rel="apple-touch-icon" href="/Icons/favicon-32x32.ico" />
    <meta name="viewport" content="width=device-width" />

    <!-- 添加sitemaps -->
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:type" content="website" />
    <meta name="description" content="你好呀陌生人，欢迎来到我的博客！" />
    <meta property="og:site_name" content="HexCss's Blog" />
    <meta
      property="og:description"
      content="你好呀陌生人，欢迎来到我的博客！"
    />
    <title>
      {params?.title ? params.title + " --HexCss's blog" : "HexCss's blog"}
    </title>
    <ClientRouter />

    <!-- DOM还未加载的时候就需要读取的一些元素信息 -->
    <script>
      import { initBgStateFromStorage } from "@/stores/theme";
      initBgStateFromStorage();
    </script>
  </head>
  <body data-theme="light" transition:animate="fade" class="h-fit">
    <!-- 光标 -->
    <NormalCursor />
    
    <!-- 这里应该用fixed来当作固定在视口的背景 -->
    <div
      class="fixed w-screen h-screen dark:bg-black bg-cover bg-center bg-no-repeat transition-background-image duration-300 ease-in-out
      z-[-1]"
      style="background-image: var(--background-src);"
    >
      <!-- 覆盖一层毛玻璃 -->
      <div
        data-ui="real-visual-container"
        class="h-full w-full backdrop-blur-(--blur-val)"
      >
      </div>
    </div>

    <!-- 小插件 -->
    <AudioPlayerAside />

    <!-- react版本 -->
     <!-- <ReactAudioPlayerAside client:only="react" /> -->

    <!-- 内容容器 -->
    <div class="w-full flex flex-col items-center">
      <!-- 内容容器 -->
      <!-- 要规定尺寸，大小，展示方式等等 -->
      <div
        data-ui="visual-content-area"
        class="w-full min-w-[320px] max-w-350 px-4 pb-5 grid gap-3 grid-cols-[300px_1fr] max-[1024px]:grid-cols-[240px_1fr] grid-rows-[auto_1fr_auto] max-[768px]:grid-cols-[1fr]"
      >
        <!-- 导航栏 -->
        <div class="col-span-1 md:col-span-2 z-999">
          <Header />
        </div>

        <!-- 左侧个人信息栏 -->
        <!-- 这里也可以替换成导航栏 -->
        <div class="max-[768px]:hidden">
          <slot name="asidePanel">
            <AsideInfo />
          </slot>
        </div>

        <!-- 正文博客内容展示 -->
        <div
          class="min-w-0"
        >
          <slot name="mainContent" />
        </div>

        <!-- 底部内容 -->
        <div class="col-span-1 md:col-span-2 mt-5">
          <Footer />
        </div>
      </div>

      <!-- 右侧侧边栏,用于回到页面顶部 -->
      <button
        data-ui="to-top-btn"
        class="text-body fixed right-4 bottom-4 w-10 h-10 transition-all ease-in-out duration-300 hover:text-[purple] hover:-translate-y-1"
        >
        <ToTopIcon />
        </button>
    </div>
    
    <script>
      import {
        bgState,
        setBgUrl,
        setMediaDevice,
        mediaDevice,
        fetchBackgroundImage,
        revokeBackgroundImage,
      } from "@/stores/theme";

      //  记录url
      let bgUrl: string;

      // 初始化滚动容器
      function initScroll() {
        // 获取滚动btn
        const toTopBtn = document.querySelector('[data-ui="to-top-btn"]');
        // 滚动到视口顶部
        function scrollTop() {
          window.scrollTo({ top: 0, behavior: "smooth" });
        }
        // 监听向上btn
        toTopBtn?.addEventListener("click", scrollTop);
      }

      // 初始化标题设置脚本
      function initTitleScript() {
        let titleTimeoutId: ReturnType<typeof setTimeout> | undefined;
        // 如果页面失去聚焦，则修改title
        document.addEventListener("visibilitychange", () => {
          if (document.visibilityState === "hidden") {
            // 清空titleTimeout
            clearTimeout(titleTimeoutId);
            document.title = "¯﹃¯大脑宕机ing...";
          } else {
            document.title = "๑´ڡ`๑欢迎回来，狗修金SAMA~";
            titleTimeoutId = setTimeout(() => {
              document.title = originTitle;
            }, 1500);
          }
        });
      }

      // 初始化主题色彩
      function initTheme() {
        let theme = localStorage.getItem("theme")
          ? localStorage.getItem("theme")
          : "light";
        if (theme === "match-media") {
          theme = window.matchMedia("(prefers-color-scheme: light)").matches
            ? "light"
            : "dark";
        }
        window.document.documentElement.dataset.theme = theme!;
      }

      // 初始化背景图片
      async function initBackground() {
        // 首先需要设置mediaDevice
        setMediaDevice();
        // 并且还要给网站注册对应的事件
        window.addEventListener("resize", async () => {
          if (bgState.disabledBtnIsActived) return;
          const oldMediaDevice = mediaDevice;
          setMediaDevice();
          if (mediaDevice !== oldMediaDevice) {
            // 修改类型，则需要修改背景
            const bgUrl = await fetchBackgroundImage();

            // 设置bgUrl作为dom中的背景
            document.documentElement.style.setProperty(
              "--background-src",
              `url(${bgUrl})`,
            );
            // 销毁掉原来的bgUrl对象
            revokeBackgroundImage();
          }
        });
        // 如果禁用图片，就跳过
        if (bgState.disabledBtnIsActived) {
          return;
        }
        // 如果设置了背景图片，就直接使用，否则就去获取一个随机背景图
        if (
          getComputedStyle(document.documentElement).getPropertyValue(
            "--background-src",
          ) === "none"
        ) {
          const bgUrl = await fetchBackgroundImage();
          document.documentElement.style.setProperty(
            "--background-src",
            `url(${bgUrl})`,
          );

          // 存放到全局状态当中
          setBgUrl(bgUrl);
        } else {
          // 使用保存的bgUrl
          document.documentElement.style.setProperty(
            "--background-src",
            `url(${bgState.bgUrl})`,
          );
        }
      }

      // 普通页面进来就需要做的初始化
      function init() {
        initTheme();
        initScroll();
        initTitleScript();
      }

      // 路由切换(站内切换，不更新图片)后将之前的Url设置回去
      document.addEventListener("astro:after-swap", () => {
        // 初始化其他应当进行初始化的script
        init();

        if (bgState.disabledBtnIsActived) {
          return;
        }
        // 设置background-src的url
        document.documentElement.style.setProperty(
          "--background-src",
          `url(${bgState.bgUrl})`,
        );
      });

      const originTitle = document.title;
      // 改变title标题

      // 如果刷新页面，直接执行 init 函数
      document.addEventListener("DOMContentLoaded", () => {
        init();
        initBackground();
      });

    </script>
  </body>
</html>
